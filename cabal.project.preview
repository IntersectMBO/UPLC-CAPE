-- Preview cabal project: uses the newest plutus-core release from CHaP.
-- This file builds the measure-preview evaluator for submissions targeting
-- a protocol version that mainnet has not activated yet.
--
-- Usage: cabal --project-file=cabal.project.preview build measure-preview

import: cabal.project

-- Enable preview flag to build the measure-preview executable
flags: +preview

-- Pin plutus-* to the latest released line (1.68, released 2026-08-21). The
-- allow-newer below lifts cape.cabal's production ^>=1.63 bound; this block is
-- what then forces 1.68 rather than letting the solver fall back. The CHaP
-- index-state that resolves it is inherited from cabal.project.
constraints:
    plutus-core       ^>=1.68
  , plutus-ledger-api ^>=1.68
  , plutus-tx         ^>=1.68
  , plutus-tx-plugin  ^>=1.68

-- Relax version constraints to accept newer plutus packages
allow-newer:
    cape:plutus-core
  , cape:plutus-ledger-api
  , cape:plutus-tx
  , cape:plutus-tx-plugin
