{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/IntersectMBO/UPLC-CAPE/schemas/cape-tests.schema.json",
  "title": "CAPE Test Specification",
  "description": "Schema for cape-tests.json files that define test cases for UPLC program evaluation with ScriptContext support",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "enum": ["3.0.0"]
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the test suite"
    },
    "data_structures": {
      "type": "object",
      "description": "Shared data structures that can be referenced by tests using @name syntax",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "$ref": "#/$defs/data_structure_entry"
        }
      },
      "additionalProperties": false
    },
    "measurements": {
      "type": "array",
      "description": "Test cases that verify correctness AND feed the aggregated metrics (sums, maxima, medians, derived fees and budget percentages). These are the executions that occur in standard protocol operation.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test_case"
      }
    },
    "checks": {
      "type": "array",
      "description": "Test cases that verify correctness only: attacks, malformed inputs, defensive checks, and rejected-path calls in general (a rejecting transaction is stopped by wallet/node validation before it lands on-chain). Their measured budget is recorded in metrics.json evaluations[] but excluded from aggregates.",
      "items": {
        "$ref": "#/$defs/test_case"
      }
    }
  },
  "required": ["version", "measurements"],
  "additionalProperties": false,
  "$defs": {
    "builtin_data_value": {
      "description": "BuiltinData value. Encoded either as a string in UPLC text Data syntax (e.g. \"Constr 0 [I 42, B #cafe]\", \"I 42\", \"B #deadbeef\", \"List [I 1, I 2]\", \"Map [(I 1, B #ab)]\") or as an object in the Plutus JSON detailed schema (e.g. {\"int\": 42}, {\"bytes\": \"deadbeef\"}, {\"constructor\": 0, \"fields\": [...]}, {\"list\": [...]}, {\"map\": [{\"k\": ..., \"v\": ...}]}). A string value of the form \"@name\" is a reference into data_structures.",
      "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/plutus_json_data" }]
    },
    "plutus_json_data": {
      "description": "Plutus Data in the cardano-cli ScriptDataJsonDetailedSchema format.",
      "type": "object",
      "oneOf": [
        {
          "properties": { "int": { "type": "integer" } },
          "required": ["int"],
          "additionalProperties": false
        },
        {
          "properties": { "bytes": { "type": "string", "pattern": "^[0-9a-fA-F]*$" } },
          "required": ["bytes"],
          "additionalProperties": false
        },
        {
          "properties": {
            "list": {
              "type": "array",
              "items": { "$ref": "#/$defs/plutus_json_data" }
            }
          },
          "required": ["list"],
          "additionalProperties": false
        },
        {
          "properties": {
            "map": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "k": { "$ref": "#/$defs/plutus_json_data" },
                  "v": { "$ref": "#/$defs/plutus_json_data" }
                },
                "required": ["k", "v"],
                "additionalProperties": false
              }
            }
          },
          "required": ["map"],
          "additionalProperties": false
        },
        {
          "properties": {
            "constructor": { "type": "integer", "minimum": 0 },
            "fields": {
              "type": "array",
              "items": { "$ref": "#/$defs/plutus_json_data" }
            }
          },
          "required": ["constructor", "fields"],
          "additionalProperties": false
        }
      ]
    },
    "data_structure_entry": {
      "type": "object",
      "description": "Shared data structure definition",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "type": "object",
          "description": "BuiltinData entry",
          "properties": {
            "type": {
              "const": "builtin_data"
            },
            "value": {
              "$ref": "#/$defs/builtin_data_value"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "ScriptContext entry",
          "properties": {
            "type": {
              "const": "script_context"
            },
            "script_context": {
              "$ref": "#/$defs/script_context_spec"
            }
          },
          "required": ["type", "script_context"],
          "additionalProperties": false
        }
      ]
    },
    "test_case": {
      "type": "object",
      "description": "Individual test case specification",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique identifier for the test case",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what the test verifies"
        },
        "pending": {
          "type": "boolean",
          "description": "Mark test as pending - expected to fail until fixed. When true, test failures don't affect suite success, but if test starts passing, it becomes an error."
        },
        "inputs": {
          "type": "array",
          "description": "Inputs applied to the program sequentially (empty for programs evaluated without arguments)",
          "items": {
            "$ref": "#/$defs/test_input"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected_result"
        }
      },
      "required": ["name", "inputs", "expected"],
      "additionalProperties": false
    },
    "test_input": {
      "type": "object",
      "description": "Input specification for program evaluation",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "type": "object",
          "description": "BuiltinData input",
          "properties": {
            "type": {
              "const": "builtin_data"
            },
            "value": {
              "$ref": "#/$defs/builtin_data_value"
            },
            "file": {
              "type": "string",
              "description": "Path to file containing a BuiltinData value as UPLC text Data syntax (relative to cape-tests.json)"
            }
          },
          "required": ["type"],
          "additionalProperties": false,
          "oneOf": [{ "required": ["value"] }, { "required": ["file"] }]
        },
        {
          "type": "object",
          "description": "UPLC term input (spliced into the program as an argument)",
          "properties": {
            "type": {
              "const": "uplc"
            },
            "value": {
              "type": "string",
              "description": "Inline UPLC term text, e.g. \"(con integer 42)\""
            },
            "file": {
              "type": "string",
              "description": "Path to file containing UPLC term text (relative to cape-tests.json)"
            }
          },
          "required": ["type"],
          "additionalProperties": false,
          "oneOf": [{ "required": ["value"] }, { "required": ["file"] }]
        },
        {
          "type": "object",
          "description": "ScriptContext input",
          "properties": {
            "type": {
              "const": "script_context"
            },
            "script_context": {
              "$ref": "#/$defs/script_context_spec"
            }
          },
          "required": ["type", "script_context"],
          "additionalProperties": false
        }
      ]
    },
    "script_context_spec": {
      "type": "object",
      "description": "ScriptContext construction specification",
      "properties": {
        "baseline": {
          "description": "Baseline context to start from",
          "oneOf": [
            {
              "type": "string",
              "enum": ["spending"],
              "description": "Direct baseline type. Other purposes are reached with the set_script_info patch."
            },
            {
              "type": "string",
              "pattern": "^@[a-zA-Z_][a-zA-Z0-9_]*$",
              "description": "Reference to shared ScriptContext (@name)"
            }
          ]
        },
        "patches": {
          "type": "array",
          "description": "Patch operations to apply to the baseline",
          "items": {
            "$ref": "#/$defs/patch_operation"
          }
        }
      },
      "required": ["baseline", "patches"],
      "additionalProperties": false
    },
    "patch_operation": {
      "type": "object",
      "description": "ScriptContext modification operation",
      "discriminator": {
        "propertyName": "op"
      },
      "oneOf": [
        {
          "type": "object",
          "description": "Add signature to transaction",
          "properties": {
            "op": { "const": "add_signature" },
            "pubkey_hash": {
              "type": "string",
              "description": "PubKey hash: an @reference to a bytestring gives those bytes; a literal is taken as its raw ASCII bytes, not as hex"
            }
          },
          "required": ["op", "pubkey_hash"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Remove signature from transaction",
          "properties": {
            "op": { "const": "remove_signature" },
            "pubkey_hash": {
              "type": "string",
              "description": "PubKey hash: an @reference to a bytestring gives those bytes; a literal is taken as its raw ASCII bytes, not as hex"
            }
          },
          "required": ["op", "pubkey_hash"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Set transaction redeemer",
          "properties": {
            "op": { "const": "set_redeemer" },
            "redeemer": {
              "$ref": "#/$defs/builtin_data_value"
            }
          },
          "required": ["op", "redeemer"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Add input UTXO to transaction",
          "properties": {
            "op": { "const": "add_input_utxo" },
            "utxo_ref": {
              "$ref": "#/$defs/utxo_ref"
            },
            "address": {
              "$ref": "#/$defs/address_spec",
              "description": "Address of the input. Omitted: the placeholder script address when is_own_input is true, an empty public key hash otherwise."
            },
            "value": {
              "$ref": "#/$defs/value_spec"
            },
            "is_own_input": {
              "type": "boolean",
              "description": "Whether this is the UTXO being spent by the script. True also makes it the reference of the spending purpose."
            },
            "datum": {
              "$ref": "#/$defs/builtin_data_value"
            },
            "reference_script": {
              "$ref": "#/$defs/reference_script"
            }
          },
          "required": ["op", "utxo_ref", "value", "is_own_input"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Add output UTXO to transaction",
          "properties": {
            "op": { "const": "add_output_utxo" },
            "address": {
              "$ref": "#/$defs/address_spec"
            },
            "value": {
              "$ref": "#/$defs/value_spec"
            },
            "datum": {
              "$ref": "#/$defs/builtin_data_value"
            },
            "reference_script": {
              "$ref": "#/$defs/reference_script"
            }
          },
          "required": ["op", "address", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Remove output UTXO by index",
          "properties": {
            "op": { "const": "remove_output_utxo" },
            "index": {
              "type": "integer",
              "description": "Zero-based index of output to remove",
              "minimum": 0
            }
          },
          "required": ["op", "index"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Set transaction validity time range",
          "properties": {
            "op": { "const": "set_valid_range" },
            "from_time": {
              "type": "integer",
              "description": "Inclusive lower bound, POSIX time in milliseconds (optional). Encoded as the ledger does: LowerBound (Finite t) True. Omitted means NegInf.",
              "minimum": 0
            },
            "to_time": {
              "type": "integer",
              "description": "Exclusive upper bound, POSIX time in milliseconds (optional). Encoded as the ledger does: UpperBound (Finite t) False. Omitted means PosInf.",
              "minimum": 0
            }
          },
          "required": ["op"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Set the datum of the script's own input",
          "properties": {
            "op": { "const": "set_script_datum" },
            "datum": {
              "$ref": "#/$defs/builtin_data_value"
            }
          },
          "required": ["op", "datum"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Replace the script purpose and keep the transaction as it is, so one transaction can be evaluated under each purpose it triggers",
          "properties": {
            "op": { "const": "set_script_info" },
            "script_info": {
              "$ref": "#/$defs/script_info_spec"
            }
          },
          "required": ["op", "script_info"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Replace the mint field of the transaction. The result has the ledger's shape: policies and token names in ascending byte order, duplicates summed, zero quantities dropped, no ADA entry.",
          "properties": {
            "op": { "const": "set_mint" },
            "assets": {
              "type": "array",
              "description": "Minted and burned assets; an empty array gives an empty mint field",
              "items": {
                "$ref": "#/$defs/asset_spec"
              }
            }
          },
          "required": ["op", "assets"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Set the transaction fee",
          "properties": {
            "op": { "const": "set_fee" },
            "lovelace": {
              "type": "integer",
              "description": "Fee in lovelace",
              "minimum": 0
            }
          },
          "required": ["op", "lovelace"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Set the transaction id",
          "properties": {
            "op": { "const": "set_tx_id" },
            "tx_id": {
              "type": "string",
              "description": "Transaction id, in the two forms of the txid part of utxo_ref: '#' followed by hex gives the decoded bytes, otherwise the characters themselves are the id",
              "pattern": "^(#([0-9a-fA-F]{2})+|[^#:][^:]*)$"
            }
          },
          "required": ["op", "tx_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Replace the redeemers of the transaction: the map that every script of the transaction sees, in the given order. Independent of set_redeemer, which sets the redeemer of the script under test.",
          "properties": {
            "op": { "const": "set_redeemers" },
            "redeemers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "purpose": {
                    "$ref": "#/$defs/purpose_spec"
                  },
                  "redeemer": {
                    "$ref": "#/$defs/builtin_data_value"
                  }
                },
                "required": ["purpose", "redeemer"],
                "additionalProperties": false
              }
            }
          },
          "required": ["op", "redeemers"],
          "additionalProperties": false
        }
      ]
    },
    "value_spec": {
      "type": "object",
      "description": "Multi-asset value: lovelace plus optional native assets",
      "properties": {
        "lovelace": {
          "type": "integer",
          "description": "Lovelace amount",
          "minimum": 0
        },
        "assets": {
          "type": "array",
          "description": "Native assets included in the value",
          "items": {
            "$ref": "#/$defs/asset_spec"
          }
        }
      },
      "required": ["lovelace"],
      "additionalProperties": false
    },
    "asset_spec": {
      "type": "object",
      "description": "A native asset: policy id, token name and quantity",
      "properties": {
        "currency_symbol": {
          "type": "string",
          "description": "Policy id: an @reference to a bytestring or a UPLC text Data literal such as 'B #dddd'"
        },
        "token_name": {
          "type": "string",
          "description": "Token name: an @reference to a bytestring or a UPLC text Data literal such as 'B #7465'"
        },
        "quantity": {
          "type": "integer",
          "description": "Asset quantity. In set_mint a negative quantity burns."
        }
      },
      "required": ["currency_symbol", "token_name", "quantity"],
      "additionalProperties": false
    },
    "utxo_ref": {
      "type": "string",
      "description": "UTXO reference as 'txid:index', or an @reference to a builtin_data string that holds one. A txid with a leading '#' is hex and gives the decoded bytes (64 hex digits make the 32-byte id the ledger produces). Without the prefix the characters themselves are the id (legacy form).",
      "pattern": "^(@[a-zA-Z_][a-zA-Z0-9_]*|#([0-9a-fA-F]{2})+:[0-9]+|[^#@:][^:]*:[0-9]+)$"
    },
    "address_spec": {
      "type": "object",
      "description": "Cardano address: a payment credential, given by type and its hash field, and an optional staking credential",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "type": "object",
          "description": "Script address",
          "properties": {
            "type": { "const": "script" },
            "script_hash": { "$ref": "#/$defs/script_hash" },
            "staking": { "$ref": "#/$defs/credential_spec" }
          },
          "required": ["type", "script_hash"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Public key address",
          "properties": {
            "type": { "const": "pubkey" },
            "pubkey_hash": { "$ref": "#/$defs/pubkey_hash" },
            "staking": { "$ref": "#/$defs/credential_spec" }
          },
          "required": ["type", "pubkey_hash"],
          "additionalProperties": false
        }
      ]
    },
    "credential_spec": {
      "type": "object",
      "description": "Payment or staking credential",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "type": "object",
          "description": "Script credential",
          "properties": {
            "type": { "const": "script" },
            "script_hash": { "$ref": "#/$defs/script_hash" }
          },
          "required": ["type", "script_hash"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Public key credential",
          "properties": {
            "type": { "const": "pubkey" },
            "pubkey_hash": { "$ref": "#/$defs/pubkey_hash" }
          },
          "required": ["type", "pubkey_hash"],
          "additionalProperties": false
        }
      ]
    },
    "script_hash": {
      "type": "string",
      "description": "Script hash: an @reference to a bytestring gives those bytes; a literal is taken as its raw ASCII bytes, not as hex"
    },
    "pubkey_hash": {
      "type": "string",
      "description": "Public key hash: an @reference to a bytestring gives those bytes; a literal is taken as its raw ASCII bytes, not as hex"
    },
    "reference_script": {
      "type": "string",
      "description": "Hash of the reference script the UTXO carries: an @reference to a bytestring or a UPLC text Data literal such as 'B #dddd'"
    },
    "purpose_spec": {
      "type": "object",
      "description": "Script purpose of a set_redeemers entry",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "type": "object",
          "description": "Spending purpose",
          "properties": {
            "type": { "const": "spending" },
            "utxo_ref": {
              "$ref": "#/$defs/utxo_ref"
            }
          },
          "required": ["type", "utxo_ref"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Minting purpose",
          "properties": {
            "type": { "const": "minting" },
            "policy_id": {
              "type": "string",
              "description": "Policy id: an @reference to a bytestring or a UPLC text Data literal such as 'B #dddd'"
            }
          },
          "required": ["type", "policy_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Rewarding purpose",
          "properties": {
            "type": { "const": "rewarding" },
            "credential": {
              "$ref": "#/$defs/credential_spec"
            }
          },
          "required": ["type", "credential"],
          "additionalProperties": false
        }
      ]
    },
    "script_info_spec": {
      "type": "object",
      "description": "Script purpose for the set_script_info patch",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "type": "object",
          "description": "Minting purpose",
          "properties": {
            "type": { "const": "minting" },
            "policy_id": {
              "type": "string",
              "description": "Policy id: an @reference to a bytestring or a UPLC text Data literal such as 'B #dddd'"
            }
          },
          "required": ["type", "policy_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Rewarding purpose",
          "properties": {
            "type": { "const": "rewarding" },
            "credential": {
              "$ref": "#/$defs/credential_spec"
            }
          },
          "required": ["type", "credential"],
          "additionalProperties": false
        }
      ]
    },
    "expected_result": {
      "type": "object",
      "description": "Expected evaluation result",
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of expected result",
          "enum": ["value", "error"]
        },
        "content": {
          "type": "string",
          "description": "Inline expected pretty-printed UPLC term"
        },
        "file": {
          "type": "string",
          "description": "Path to file containing expected result (relative to cape-tests.json)"
        }
      },
      "required": ["type"],
      "additionalProperties": false,
      "if": {
        "properties": {
          "type": { "const": "value" }
        }
      },
      "then": {
        "oneOf": [{ "required": ["content"] }, { "required": ["file"] }]
      },
      "else": {
        "not": {
          "anyOf": [{ "required": ["content"] }, { "required": ["file"] }]
        }
      }
    }
  }
}
